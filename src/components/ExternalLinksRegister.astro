---
import { ArrowUpRight, Star } from "@lucide/astro";
import { site } from "@/data/site";

type Props = {
  theme?: "light" | "dark";
};

const { theme = "light" } = Astro.props;
const links = [
  {
    meta: "Follow",
    label: site.social[0].label,
    href: site.social[0].href,
    icon: "facebook",
  },
  {
    meta: "Review",
    label: site.googleReview.label,
    href: site.googleReview.href,
    icon: "review",
  },
];
---

<div class:list={["external-link-register", `external-link-register--${theme}`]}>
  {links.map((link) => (
    <a
      class="external-link-register__link"
      href={link.href}
      target="_blank"
      rel="noreferrer"
      aria-label={`${link.meta} ${link.label} — Bennett Advisory (opens in a new tab)`}
    >
      <span class="external-link-register__brand-icon" aria-hidden="true">
        {link.icon === "facebook" ? (
          <svg viewBox="0 0 24 24" role="presentation">
            <path
              fill="currentColor"
              d="M13.7 21v-8h2.8l.4-3.1h-3.2V8c0-.9.3-1.5 1.6-1.5H17V3.7c-.5-.1-1.3-.2-2.4-.2-2.4 0-4 1.4-4 4.1v2.3H8V13h2.6v8h3.1Z"
            />
          </svg>
        ) : (
          <Star size={20} stroke-width={1.7} />
        )}
      </span>
      <span class="external-link-register__copy">
        <small>{link.meta}</small>
        <strong>{link.label}</strong>
      </span>
      <ArrowUpRight
        class="external-link-register__arrow"
        size={18}
        stroke-width={1.6}
        aria-hidden="true"
      />
    </a>
  ))}
</div>
