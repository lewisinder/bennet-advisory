---
import { withBase } from "@/lib/base";

const productionAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const accessKey = process.env.DEPLOY_TARGET === "cloudflare-preview"
  ? import.meta.env.PUBLIC_WEB3FORMS_TEST_ACCESS_KEY || productionAccessKey
  : productionAccessKey;
---

<form
  class="form"
  data-enquiry-form
  data-form-ready={accessKey ? "true" : "false"}
  data-success-url={withBase("/thank-you/")}
>
  {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
  <input type="hidden" name="subject" value="New Bennett Advisory website enquiry" />
  <input type="hidden" name="from_name" value="Bennett Advisory website" />
  <input
    class="visually-hidden"
    type="checkbox"
    name="botcheck"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="form-row">
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="contact-phone">Phone <span class="field-hint">(optional)</span></label>
      <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="contact-email">Email</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" required></textarea>
    <span class="field-hint">A short outline is plenty. Please do not include sensitive financial information.</span>
  </div>

  <button class="btn btn--primary" type="submit" data-submit-button>Send</button>
  <p class="form-status" data-form-status aria-live="polite"></p>
</form>

<script is:inline>
  document.querySelectorAll("[data-enquiry-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const status = form.querySelector("[data-form-status]");
      const button = form.querySelector("[data-submit-button]");

      if (form.dataset.formReady !== "true") {
        if (status) {
          status.textContent = "This preview form is not connected yet. Please call or email Bennett Advisory.";
        }
        return;
      }

      if (!(button instanceof HTMLButtonElement)) return;

      button.disabled = true;
      button.textContent = "Sending…";
      if (status) status.textContent = "Sending your enquiry…";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error("The enquiry could not be sent.");
        }

        window.location.assign(form.dataset.successUrl || "/thank-you/");
      } catch {
        if (status) {
          status.textContent = "We couldn't send your enquiry. Please try again or contact Bennett Advisory by phone or email.";
        }
        button.disabled = false;
        button.textContent = "Send";
      }
    });
  });
</script>
