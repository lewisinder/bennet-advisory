---
import { Image } from "astro:assets";
import melanie from "@/assets/melanie-bennett.jpeg";
import sarah from "@/assets/sarah-clay.jpg";
import type { TeamMember } from "@/data/team";

type Props = { member: TeamMember; index: number; compact?: boolean };
const { member, index, compact = false } = Astro.props;
const portraits = { melanie, sarah };
const portrait = member.image ? portraits[member.image] : undefined;
const initials = member.name.split(" ").map((part) => part[0]).join("");
---

<article class:list={["team-member", compact && "team-member--compact"]}>
  <div class="team-member__media">
    {portrait ? (
      <Image
        src={portrait}
        alt={`Portrait of ${member.name}`}
        widths={[320, 540, 760]}
        sizes={compact ? "(max-width: 760px) 100vw, 240px" : "(max-width: 760px) 100vw, 34vw"}
        loading="lazy"
      />
    ) : (
      <div class="team-member__initials" aria-hidden="true">{initials}</div>
    )}
  </div>
  <div class="team-member__copy">
    <span class="service-number">{String(index + 1).padStart(2, "0")}</span>
    <p class="team-member__role">{member.role} · {member.experience}</p>
    <h3>{member.name}</h3>
    <p>{member.bio}</p>
  </div>
</article>
