---
import { Image } from "astro:assets";
import logo from "@/assets/bennett-advisory-logo.png";
import { site } from "@/data/site";
import { withBase } from "@/lib/base";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <div class="footer-brand__logo">
        <Image src={logo} alt={site.name} width={190} quality={95} />
      </div>
      <p>{site.tagline}</p>
    </div>

    <div>
      <p class="footer-label">Pages</p>
      <ul>
        {site.nav.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="footer-label">Contact</p>
      <ul>
        <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.address.locality}, {site.address.region}</li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} {site.legalName}</span>
    <span>French Bay · Titirangi · Auckland</span>
  </div>
</footer>
