---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import { credentials } from "@/data/credentials";

type Props = {
  showLaunchNote?: boolean;
};

const { showLaunchNote = false } = Astro.props;
---

<div class="credential-register">
  {credentials.map((credential) => (
    <article class={`credential-entry credential-entry--${credential.id}`}>
      <span class="credential-entry__category">{credential.category}</span>
      <a
        class="credential-entry__mark"
        href={credential.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Learn more about ${credential.name}`}
      >
        <Image
          src={credential.image}
          alt={credential.alt}
          widths={[240, 420, 640]}
          sizes="(max-width: 820px) 65vw, 280px"
          loading="lazy"
        />
      </a>
      <div class="credential-entry__copy">
        <h3>{credential.name}</h3>
        <p>{credential.description}</p>
        <a href={credential.href} target="_blank" rel="noopener noreferrer">
          Learn more
          <ArrowUpRight size={14} aria-hidden="true" />
        </a>
      </div>
    </article>
  ))}
</div>

{showLaunchNote && (
  <p class="credential-launch-note">
    Internal launch note: confirm current permission and status before publishing
    the STEP, Chartered Accountants and Xero marks on the production site.
  </p>
)}
