---
import { Image } from "astro:assets";
import { ArrowDown, ArrowRight, ArrowUpRight, MapPin } from "@lucide/astro";
import heroPhoto from "@/assets/french-bay-waterfront.jpg";
import locationPhoto from "@/assets/french-bay-yacht-club.jpeg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import CredentialRegister from "@/components/CredentialRegister.astro";
import TeamMember from "@/components/TeamMember.astro";
import CtaBand from "@/components/CtaBand.astro";
import { site } from "@/data/site";
import {
  serviceGroupCopy,
  serviceGroups,
  services,
} from "@/data/services";
import { home } from "@/data/home";
import { team } from "@/data/team";
import { withBase } from "@/lib/base";
---

<BaseLayout title={home.seo.title} description={home.seo.description}>
  <section class="home-hero">
    <div class="home-hero__copy">
      <div class="home-hero__inner">
        <span class="overline">{home.hero.overline}</span>
        <h1>{home.hero.heading}</h1>
        <p>{home.hero.text}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={withBase("/contact/")}>
            Get in touch
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a class="btn btn--outline-light" href="#introduction">
            Learn how we can help you
          </a>
        </div>
        <a class="hero-marker" href="#introduction">
          <span></span>
          Bennett Advisory · New Zealand
          <ArrowDown size={13} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="home-hero__photo">
      <Image
        src={heroPhoto}
        alt="Pōhutukawa trees beside the water at French Bay, Auckland"
        widths={[720, 1000, 1440]}
        sizes="(max-width: 900px) 100vw, 44vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="home-hero__wash"></div>
      <aside class="practice-register" aria-label="Areas of practice">
        <header>
          <span>Bennett Advisory</span>
          <span>Practice register</span>
        </header>
        <h2>Areas of practice</h2>
        <ol>
          {services.map((service) => (
            <li>
              <span>{service.number}</span>
              <a href={`#${service.id}`}>{service.name}</a>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <section class="introduction section" id="introduction">
    <div class="container introduction__inner">
      <p class="eyebrow">{home.introduction.eyebrow}</p>
      <h2>{home.introduction.heading}</h2>
      <p class="lead">{home.introduction.text}</p>
    </div>
  </section>

  <section class="services-section section" id="services">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">Accounting · Tax · Trusts</p>
          <h2>Accounting, tax and trust services</h2>
        </div>
        <p>
          Practical advice for New Zealand families, businesses and trustees.
        </p>
      </div>

      <div class="service-ledger">
        {serviceGroups.map((group, groupIndex) => (
          <section class="service-folder" aria-labelledby={`group-${groupIndex}`}>
            <h3 class="folder-tab" id={`group-${groupIndex}`}>{group}</h3>
            <div class="service-folder__body">
              <div class="service-folder__intro">
                {serviceGroupCopy[group].map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="service-folder__entries">
                {services.filter((service) => service.group === group).map((service) => (
                  <ServiceCard service={service} />
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>
      <div class="section-footer-action">
        <p>Would you like to talk through which service fits your situation?</p>
        <a class="text-link" href={withBase("/contact/")}>
          Contact us to learn more
          <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="trust-review-section section">
    <div class="container trust-review">
      <div class="trust-review__copy">
        <p class="eyebrow">{home.trustReview.eyebrow}</p>
        <h2>{home.trustReview.heading}</h2>
        {home.trustReview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href={withBase("/contact/")}>
          Ask about a trust health-check
          <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>
      <ol class="trust-review__stages">
        {home.trustReview.stages.map((stage) => (
          <li>
            <span>{stage.number}</span>
            <div>
              <h3>{stage.title}</h3>
              <p>{stage.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="credentials-section section">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">Professional standards</p>
          <h2>Experience supported by trusted professional networks</h2>
        </div>
        <p>
          Specialist trust knowledge, Chartered Accountant expertise and
          cloud-based accounting support sit behind the work.
        </p>
      </div>
      <CredentialRegister />
    </div>
  </section>

  <section class="reasons-section section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Clear, practical and built for the long term</p>
        <h2>Professional advice you can understand</h2>
      </div>
      <div class="reason-register">
        {home.reasons.map((reason) => (
          <article>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section section">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">A straightforward process</p>
          <h2>How we take you from the first conversation to ongoing compliance</h2>
        </div>
        <p>
          We start with your goals and requirements, then review, advise and
          implement the work needed.
        </p>
      </div>
      <ol class="process-list">
        {home.process.map((step) => (
          <li>
            <span class="process-number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <aside class="client-portal">
        <div>
          <span class="eyebrow">Trust administration portal</span>
          <h3>{home.portal.heading}</h3>
          <p>{home.portal.text}</p>
        </div>
        <a
          class="btn btn--secondary"
          href={home.portal.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open client portal
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </aside>
    </div>
  </section>

  <section class="experience-band">
    <div class="container experience-grid">
      <div class="experience-intro">
        <p class="eyebrow">Depth across the practice</p>
        <h2>Decades of accounting, tax and trust experience</h2>
        <p>
          Melanie has over 10 years of tax experience within Big Four firms to a
          Senior Manager level, as well as leading the corporate tax team at
          Guardian Trust, now Perpetual Guardian.
        </p>
      </div>
      <dl class="experience-facts">
        {home.experience.map((fact) => (
          <div>
            <dt>{fact.value}</dt>
            <dd>{fact.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="team-preview section">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">People behind the advice</p>
          <h2>Meet the Bennett Advisory team</h2>
        </div>
        <a class="text-link" href={withBase("/about/")}>
          Meet the team
          <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>
      <div class="team-preview__grid">
        {team.map((member) => (
          <TeamMember member={member} compact />
        ))}
      </div>
    </div>
  </section>

  <section class="location-section section">
    <div class="container">
      <div class="location-card">
        <div class="location-card__copy">
          <p class="eyebrow">Based in Titirangi · Supporting New Zealand</p>
          <h2>A local practice with nationwide reach</h2>
          <p>
            Find Bennett Advisory at {site.address.venue}, {site.address.locality},
            {" "}{site.address.region}. We support clients throughout New Zealand.
          </p>
          <a class="text-link text-link--light" href={withBase("/contact/")}>
            <MapPin size={15} aria-hidden="true" />
            View contact details
          </a>
        </div>
        <div class="location-card__image">
          <Image
            src={locationPhoto}
            alt="French Bay Yacht Club in Titirangi, Auckland"
            widths={[720, 1000, 1440]}
            sizes="(max-width: 820px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Need clarity around your accounting, trust or tax position?"
    text="Start with a straightforward conversation."
  />
</BaseLayout>
