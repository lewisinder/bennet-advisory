---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ContactForm from "@/components/ContactForm.astro";
import FaqItem from "@/components/FaqItem.astro";
import CredentialRegister from "@/components/CredentialRegister.astro";
import PersonProfile from "@/components/PersonProfile.astro";
import { services } from "@/data/services";
import { team } from "@/data/team";

const colours = [
  ["Navy", "--navy", "#1B3252", "Authority, hero panels and dark bands"],
  ["Teal", "--teal", "#2BACD6", "Actions, labels and active details"],
  ["Paper", "--paper", "#F5F3EE", "Primary editorial canvas"],
  ["Paper dark", "--paper-dark", "#EAE6DF", "Folder layers and quiet contrast"],
  ["White", "--white", "#FFFFFF", "Navigation and document surfaces"],
  ["Ink", "--ink", "#16283F", "Reading text on light surfaces"],
];

const typeRoles = [
  ["Display", "Libre Baskerville", "Professional accounting, tax & trust management"],
  ["Body", "Plus Jakarta Sans", "Clear advice should also be clearly presented."],
  ["Utility", "DM Mono", "PEOPLE — BENNETT ADVISORY"],
];
---

<BaseLayout
  title="Design System"
  description="Internal Bennett Advisory design-system reference."
  robots="noindex, nofollow"
>
  <section class="page-hero page-hero--dark">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">Bennett Advisory · Internal design system</p>
        <h1>The advisory register</h1>
      </div>
      <p class="lead">
        A restrained editorial system translated from the approved prototype into
        reusable Astro tokens and components.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Document discipline, with a sense of place</h2>
        <p>
          The design borrows from orderly trust files and advisory registers: square
          folders, labelled entries, fine rules and paper layers. French Bay imagery
          keeps the practice rooted in its real Auckland setting.
        </p>
      </div>
      <div class="principle-grid">
        <article><h3>Quiet authority</h3><p>Navy carries weight; teal is reserved for action and navigation.</p></article>
        <article><h3>Editorial order</h3><p>Rules, labels and tabs make long information easy to scan.</p></article>
        <article><h3>White files</h3><p>Service information sits on a crisp white document face, with warm paper reserved for the surrounding desk and backing layer.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--paper-dark">
    <div class="container">
      <div class="section-heading">
        <h2>Colour roles</h2>
      </div>
      <div class="swatch-grid">
        {colours.map(([name, token, hex, role]) => (
          <article class="swatch">
            <div class="swatch-chip" style={`background: var(${token})`}></div>
            <div class="swatch-meta">
              <strong>{name}</strong>
              <code>{token} · {hex}</code>
              <p>{role}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Three deliberate voices</h2>
      </div>
      <div class="type-specimens">
        {typeRoles.map(([role, family, sample]) => (
          <article class={`type-specimen type-specimen--${role.toLowerCase()}`}>
            <span>{role} · {family}</span>
            <p>{sample}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper-dark" id="service-register">
    <div class="container">
      <div class="section-heading">
        <h2>Service register and actions</h2>
        <p>
          Navy tabs identify each service family. The documents remain white and
          open at the perimeter, with fine internal rules providing structure.
        </p>
      </div>
      <div class="ds-selected-treatment">
        <span class="eyebrow">Approved treatment</span>
        <h3>Open service register</h3>
      </div>
      <div class="service-folder">
        <h3 class="folder-tab">Service entry</h3>
        <div class="service-folder__body">
          <ServiceCard service={services[0]} />
          <ServiceCard service={services[4]} />
        </div>
      </div>
      <div class="ds-actions">
        <a class="btn btn--primary" href="#buttons">Primary action</a>
        <a class="btn btn--secondary" href="#buttons">Secondary action</a>
        <a class="text-link" href="#buttons">Editorial text link</a>
      </div>
      <div class="section-footer-action">
        <p>A quiet supporting action can close an information-heavy section.</p>
        <a class="text-link" href="#buttons">Supporting action</a>
      </div>
      <div class="ds-component-divider" id="credentials">
        <span class="eyebrow">Credential register</span>
        <h3>Professional standing, without a generic logo strip</h3>
        <p>
          Marks sit on a white document surface with equal visual weight, clear
          spacing and a short explanation of why each credential matters.
        </p>
      </div>
      <CredentialRegister showLaunchNote />
      <div class="ds-component-divider" id="person-profile">
        <span class="eyebrow">Person profile</span>
        <h3>Detailed professional biography</h3>
        <p>
          A portrait-led document layout gives long professional biographies room
          to breathe, with source-backed facts and personal context kept distinct.
        </p>
      </div>
      <PersonProfile member={team[0]} />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="section-heading">
          <h2>Enquiry fields</h2>
        </div>
        <ContactForm />
      </div>
      <div>
        <div class="section-heading">
          <h2>Native interaction</h2>
        </div>
        <FaqItem
          question="How does this disclosure behave?"
          answer="It uses native details and summary elements, so it works with the keyboard and without JavaScript."
        />
        <FaqItem
          question="How is motion handled?"
          answer="Transitions are brief and restrained, and all non-essential movement is removed when reduced motion is preferred."
        />
      </div>
    </div>
  </section>
</BaseLayout>
