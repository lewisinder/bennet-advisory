---
import { Image } from "astro:assets";
import { ExternalLink, Mail, Phone } from "@lucide/astro";
import locationPhoto from "@/assets/french-bay-yacht-club.jpeg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import FaqItem from "@/components/FaqItem.astro";
import { site } from "@/data/site";
import { faqs } from "@/data/faqs";
import { faqSchema } from "@/lib/seo";

const mapUrl =
  "https://www.google.com/maps/search/?api=1&query=French+Bay+Yacht+Club+Titirangi+Auckland";
---

<BaseLayout
  title="Contact"
  description="Contact Bennett Advisory in Titirangi, Auckland for practical accounting, tax or trust support. Call, email or send an initial enquiry directly to our team."
  schemas={[faqSchema(faqs)]}
>
  <section class="page-hero page-hero--dark">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h1>Tell us what you need clarity on.</h1>
      </div>
      <p class="lead">
        A short outline is enough for an initial enquiry. We can then confirm the
        most useful next step.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <div class="section-heading">
          <h2>Send the details</h2>
          <p>
            Please do not include passwords, IRD numbers or sensitive financial
            information in an initial website enquiry.
          </p>
        </div>
        <ContactForm />
      </div>

      <aside class="contact-panel">
        <h2>Contact details</h2>
        <ul class="detail-list">
          <li>
            <strong>Contact</strong>
            <span>{site.contactName}</span>
          </li>
          <li>
            <strong>Phone</strong>
            <a href={`tel:${site.phone}`}><Phone size={15} aria-hidden="true" /> {site.phoneDisplay}</a>
          </li>
          <li>
            <strong>Email</strong>
            <a href={`mailto:${site.email}`}><Mail size={15} aria-hidden="true" /> {site.email}</a>
          </li>
          <li>
            <strong>Hours</strong>
            <span>{site.hours[0].days}<br />{site.hours[0].time}</span>
          </li>
          <li>
            <strong>Postal</strong>
            <span>{site.postalAddress}</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--paper-dark">
    <div class="container location-card">
      <div class="location-card__copy">
        <p class="eyebrow">French Bay</p>
        <h2>{site.address.venue}</h2>
        <p>
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} {site.address.postalCode}
        </p>
        <p>Please arrange a time before visiting.</p>
        <a class="btn btn--outline-light" href={mapUrl} target="_blank" rel="noreferrer">
          Open in Google Maps
          <ExternalLink size={15} aria-hidden="true" />
        </a>
      </div>
      <div class="location-card__image">
        <Image
          src={locationPhoto}
          alt="French Bay Yacht Club beside the Manukau Harbour"
          widths={[600, 900, 1200]}
          sizes="(max-width: 820px) 100vw, 50vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-heading">
        <p class="eyebrow">Common questions</p>
        <h2>A useful starting point</h2>
      </div>
      <div>
        {faqs.map((faq) => (
          <FaqItem question={faq.question} answer={faq.answer} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
