---
import { Image } from "astro:assets";
import { ArrowRight, MapPin } from "@lucide/astro";
import locationPhoto from "@/assets/french-bay-yacht-club.jpeg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PersonProfile from "@/components/PersonProfile.astro";
import TeamMember from "@/components/TeamMember.astro";
import CtaBand from "@/components/CtaBand.astro";
import { about } from "@/data/about";
import { site } from "@/data/site";
import { team } from "@/data/team";
import { withBase } from "@/lib/base";

const featuredTeam = team.filter((member) => member.image);
const widerTeam = team.filter((member) => !member.image);
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <section class="page-hero page-hero--dark">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">{about.hero.eyebrow}</p>
        <h1>{about.hero.heading}</h1>
      </div>
      <p class="lead">{about.hero.text}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-intro-grid">
      <aside class="page-intro-grid__aside">
        <p class="eyebrow">The practice</p>
        <p>
          {site.address.venue}<br />
          {site.address.locality}, {site.address.region}
        </p>
      </aside>
      <div class="page-copy">
        <h2>{about.introduction.heading}</h2>
        {about.introduction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="profile-section section section--paper-dark">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">The people behind the advice</p>
          <h2>Specialist experience, brought together</h2>
        </div>
        <p>
          Bennett Advisory’s work is led by direct experience across accounting,
          tax, trusts, estates and ongoing administration.
        </p>
      </div>
      <div class="profile-register">
        {featuredTeam.map((member, index) => (
          <PersonProfile member={member} reverse={index % 2 === 1} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">Experience across the practice</p>
          <h2>Professional backgrounds that support the work</h2>
        </div>
        <p>
          The team’s experience covers the technical advice and careful
          administration behind each client relationship.
        </p>
      </div>
      <ul class="detail-list about-expertise">
        {about.expertise.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="team-preview section">
    <div class="container">
      <div class="section-heading section-heading--spread">
        <div>
          <p class="eyebrow">The wider team</p>
          <h2>Accounting and administration support</h2>
        </div>
        <p>
          Glenn and Helen bring substantial accounting and administration
          experience to the practice.
        </p>
      </div>
      <div class="team-preview__grid">
        {widerTeam.map((member) => (
          <TeamMember member={member} compact />
        ))}
      </div>
    </div>
  </section>

  <section class="location-section section">
    <div class="container">
      <div class="location-card">
        <div class="location-card__copy">
          <p class="eyebrow">French Bay · Titirangi</p>
          <h2>Based in Auckland, supporting clients across New Zealand</h2>
          <p>
            Bennett Advisory is based at {site.address.venue}, {site.address.locality},
            {" "}{site.address.region}.
          </p>
          <a class="text-link text-link--light" href={withBase("/contact/")}>
            <MapPin size={15} aria-hidden="true" />
            View contact details
            <ArrowRight size={15} aria-hidden="true" />
          </a>
        </div>
        <div class="location-card__image">
          <Image
            src={locationPhoto}
            alt="French Bay Yacht Club beside the Manukau Harbour"
            widths={[720, 1000, 1440]}
            sizes="(max-width: 820px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Need clarity around your accounting, trust or tax position?"
    text="Start with a straightforward conversation."
  />
</BaseLayout>
