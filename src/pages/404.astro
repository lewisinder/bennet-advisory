---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/base";
---

<BaseLayout
  title="Page not found"
  description="The requested Bennett Advisory page could not be found."
  robots="noindex, nofollow"
>
  <section class="not-found section">
    <div class="container">
      <span class="overline">404 / File not found</span>
      <h1>That page is not in the register.</h1>
      <p class="lead">
        The address may be old or mistyped. Return to the homepage or contact us if
        you were looking for something specific.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={withBase("/")}>Return home</a>
        <a class="btn btn--outline-light" href={withBase(site.primaryCta.href)}>Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
