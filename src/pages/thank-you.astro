---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/base";
---

<BaseLayout
  title="Thank you"
  description="Your Bennett Advisory enquiry has been received."
  robots="noindex, nofollow"
>
  <section class="not-found section">
    <div class="container">
      <span class="overline">Enquiry sent</span>
      <h1>Thank you — your message is on its way.</h1>
      <p class="lead">
        If the matter is urgent, call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
      </p>
      <a class="btn btn--primary" href={withBase("/")}>Return home</a>
    </div>
  </section>
</BaseLayout>
